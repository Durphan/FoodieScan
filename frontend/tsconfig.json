{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
     "baseUrl": "./",
     "paths": {
      "@landing/*": ["src/landing/*"],
      "@dashboard/*": ["src/dashboard/*"],
      "@shared/*": ["src/shared/*"],
      "@auth/*": ["src/auth/*"]
    }
  },
  "include": ["src"]
}
